-- --- 3. ESP SEKMESİ ---
addSectionHeader(pEsp, "--- ESP Sekmesi ---")

local espEnabled = false
local espBtn: TextButton
local activeEspItems = {}

local function removeEspForCharacter(char: Model)
	if activeEspItems[char] then
		for _, item in pairs(activeEspItems[char]) do
			if typeof(item) == "Instance" then item:Destroy() end
		end
		activeEspItems[char] = nil
	end
end

local function setupCharacterEsp(targetPlayer: Player?, char: Model)
	if not espEnabled then return end
	removeEspForCharacter(char)
	local items = {}
	
	local highlight = Instance.new("Highlight")
	highlight.Name = "AselsanESPHighlight"
	highlight.Adornee = char
	highlight.FillColor = Color3.fromRGB(255, 0, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
	highlight.FillTransparency = 0.5
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char
	table.insert(items, highlight)
	
	activeEspItems[char] = items
end

local espThread = nil
local function enableEsp()
	espThread = task.spawn(function()
		while espEnabled do
			for _, t in ipairs(getAllTargetCharacters()) do
				if t.char and not activeEspItems[t.char] then
					setupCharacterEsp(nil, t.char)
				end
			end
			task.wait(1)
		end
	end)
end

local function disableEsp()
	if espThread then task.cancel(espThread) end
	for char, _ in pairs(activeEspItems) do removeEspForCharacter(char) end
	activeEspItems = {}
end

espBtn = addButton(pEsp, "Player ESP (Kapalı)", function()
	espEnabled = not espEnabled
	if espEnabled then espBtn.Text = "Player ESP (Açık)"; enableEsp()
	else espBtn.Text = "Player ESP (Kapalı)"; disableEsp() end
end)

