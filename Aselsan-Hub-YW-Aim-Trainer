-- AIMBOT
local aimbotEnabled = false
local aimbotBtn: TextButton
local fovRadius = 150

local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Radius = fovRadius
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Thickness = 1.5
fovCircle.Filled = false
fovCircle.Transparency = 0.7

local function getBestTargetHead(): BasePart?
	local bestHead: BasePart? = nil
	local shortestDist = fovRadius
	local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	
	for _, targetData in ipairs(getAllTargetCharacters()) do
		local char = targetData.char
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChildOfClass("Humanoid")
		
		if head and hum and hum.Health > 0 then
			local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
			if onScreen then
				local headScreenPos = Vector2.new(screenPoint.X, screenPoint.Y)
				local dist = (headScreenPos - screenCenter).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					bestHead = head
				end
			end
		end
	end
	return bestHead
end

RunService.RenderStepped:Connect(function()
	fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	if aimbotEnabled then
		fovCircle.Visible = true
		local targetHead = getBestTargetHead()
		if targetHead then
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetHead.Position), 0.35)
		end
	else
		fovCircle.Visible = false
	end
end)

